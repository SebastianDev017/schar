{%- comment -%}
  Botón flotante de WhatsApp - Dr. Schär México
  Renderizar una sola vez en layout/theme.liquid, antes de </body>:
    {% render 'schar-whatsapp' %}

  Parámetros opcionales:
    number   Número internacional, solo dígitos. Default: 5215568776130
    message  Mensaje precargado. Default: "Hola, tengo una duda sobre los productos de Dr. Schär."
  Ejemplo:
    {% render 'schar-whatsapp', number: '5215568776130', message: 'Hola, quiero información de envíos.' %}

  Color del círculo: variable --schar-wa-bg en .schar-wa.
  Se oculta mientras <html> tiene schar-cart-open, schar-nav-open, schar-search-open o schar-sheet-open.
  En móvil sube por encima de la buybar de producto mientras tiene .is-visible.
{%- endcomment -%}

{%- liquid
  assign wa_number = number | default: '5215568776130' | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_message = message | default: 'Hola, tengo una duda sobre los productos de Dr. Schär.'
  assign wa_text = wa_message | url_encode | replace: '+', '%20'
  assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text

  assign wa_buybar_class = ''
  if request.page_type == 'product' and product.template_suffix != 'regalo'
    assign wa_buybar_class = ' schar-wa--buybar'
  endif
-%}

<style>
  /* =============================================
     WHATSAPP FLOTANTE - Dr. Schär
     ============================================= */
  .schar-wa {
    --schar-wa-bg: #2C1A0E;
    --schar-wa-bg-hover: #C41E3A;
    --schar-wa-icon: #FFFFFF;
    --schar-wa-shadow: rgba(44, 26, 14, 0.25);
    --schar-wa-pill-bg: #F5F0EB;
    --schar-wa-pill-text: #2C1A0E;
    --schar-wa-pill-border: #D5CBC0;
    --schar-wa-size: 58px;
    --schar-wa-icon-size: 30px;
    --schar-wa-offset: 20px;
    --schar-wa-buybar-h: 70px;
    --schar-wa-ease: cubic-bezier(0.2, 0.8, 0.2, 1);

    position: fixed;
    right: calc(var(--schar-wa-offset) + env(safe-area-inset-right, 0px));
    bottom: calc(var(--schar-wa-offset) + env(safe-area-inset-bottom, 0px));
    /* Encima del contenido; debajo del header y la buybar (999) y de los overlays (9999 en adelante) */
    z-index: 990;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--schar-wa-size);
    height: var(--schar-wa-size);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--schar-wa-bg);
    color: var(--schar-wa-icon);
    text-decoration: none;
    box-shadow: 0 4px 14px var(--schar-wa-shadow);
    opacity: 1;
    visibility: visible;
    -webkit-tap-highlight-color: transparent;
    transition:
      opacity 0.25s ease,
      visibility 0.25s linear,
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s var(--schar-wa-ease),
      bottom 0.3s var(--schar-wa-ease);
  }

  .schar-wa__icon {
    display: block;
    flex-shrink: 0;
    width: var(--schar-wa-icon-size);
    height: var(--schar-wa-icon-size);
    overflow: visible;
    color: var(--schar-wa-icon);
    fill: currentColor;
  }
  .schar-wa__icon path { fill: currentColor; }

  /* Anillo pulsante */
  .schar-wa::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid var(--schar-wa-bg);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    animation: schar-wa-pulse 3s var(--schar-wa-ease) infinite;
  }

  @keyframes schar-wa-pulse {
    0%   { opacity: 0.5; transform: scale(1); }
    60%  { opacity: 0;   transform: scale(1.5); }
    100% { opacity: 0;   transform: scale(1.5); }
  }

  .schar-wa:focus-visible::before { animation: none; }

  /* Píldora: solo desktop con mouse */
  .schar-wa__label { display: none; }

  @media (hover: hover) and (min-width: 681px) {
    .schar-wa__label {
      position: absolute;
      top: 50%;
      right: calc(100% + 12px);
      display: block;
      padding: 10px 16px;
      background-color: var(--schar-wa-pill-bg);
      border: 1px solid var(--schar-wa-pill-border);
      border-radius: 50px;
      color: var(--schar-wa-pill-text);
      font-family: 'Cabin', 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.2;
      white-space: nowrap;
      box-shadow: 0 4px 14px rgba(44, 26, 14, 0.12);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate(6px, -50%);
      transition:
        opacity 0.2s ease,
        visibility 0.2s linear,
        transform 0.2s var(--schar-wa-ease);
    }

    /* Puente invisible entre la píldora y el círculo para no perder el hover */
    .schar-wa__label::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 100%;
      width: 14px;
    }

    /* inherit: si el botón está oculto por un overlay, la píldora también */
    .schar-wa:hover .schar-wa__label {
      opacity: 1;
      visibility: inherit;
      pointer-events: inherit;
      transform: translate(0, -50%);
    }
    .schar-wa:focus-visible .schar-wa__label {
      opacity: 1;
      visibility: inherit;
      pointer-events: inherit;
      transform: translate(0, -50%);
    }
  }

  @media (hover: hover) {
    .schar-wa:hover {
      background-color: var(--schar-wa-bg-hover);
      box-shadow: 0 10px 24px var(--schar-wa-shadow);
      transform: translateY(-3px);
    }
    .schar-wa:hover::before { animation: none; }
  }

  .schar-wa:active { background-color: var(--schar-wa-bg-hover); }

  /* Foco con teclado: halo blanco + anillo café, se ve sobre fondos claros y oscuros */
  .schar-wa:focus-visible {
    background-color: var(--schar-wa-bg-hover);
    outline: 2px solid var(--schar-wa-bg);
    outline-offset: 3px;
    box-shadow: 0 0 0 3px #FFFFFF, 0 10px 24px var(--schar-wa-shadow);
  }

  /* Oculto mientras hay un overlay abierto (carrito, menú móvil, búsqueda, bottom sheet) */
  html.schar-cart-open .schar-wa,
  html.schar-nav-open .schar-wa,
  html.schar-search-open .schar-wa,
  html.schar-sheet-open .schar-wa {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (max-width: 680px) {
    .schar-wa {
      --schar-wa-size: 54px;
      --schar-wa-icon-size: 28px;
      --schar-wa-offset: 16px;
    }
  }

  /* Buybar de producto (solo existe hasta 834px) */
  @media (max-width: 834px) {
    /* Fallback sin :has(): en la ficha de producto queda siempre por encima de la buybar */
    .schar-wa--buybar {
      bottom: calc(var(--schar-wa-offset) + var(--schar-wa-buybar-h) + env(safe-area-inset-bottom, 0px));
    }

    /* Con :has(): sube solo mientras la buybar está visible */
    @supports selector(:has(*)) {
      .schar-wa--buybar {
        bottom: calc(var(--schar-wa-offset) + env(safe-area-inset-bottom, 0px));
      }
      html:has(.schar-buybar.is-visible) .schar-wa {
        bottom: calc(var(--schar-wa-offset) + var(--schar-wa-buybar-h) + env(safe-area-inset-bottom, 0px));
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .schar-wa::before { animation: none; }
    /* Se conserva bottom: acompaña el deslizamiento de la buybar y evita que se solapen */
    .schar-wa {
      transition:
        opacity 0.25s ease,
        visibility 0.25s linear,
        background-color 0.25s ease,
        box-shadow 0.25s ease,
        bottom 0.3s var(--schar-wa-ease);
    }
    .schar-wa:hover { transform: none; }
    .schar-wa__label { transform: translate(0, -50%); }
  }

  @media print {
    .schar-wa { display: none; }
  }
</style>

<a
  class="schar-wa{{ wa_buybar_class }}"
  href="{{ wa_url | escape }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
>
  <span class="schar-wa__label" aria-hidden="true">¿Dudas? Escríbenos</span>
