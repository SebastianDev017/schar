{% style %}
  @font-face {
    font-family: 'Times ExtraBold';
    src: url('https://cdn.shopify.com/s/files/1/0991/5082/3710/files/Times-ExtraBold.otf?v=1777160115') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  #shopify-section-{{ section.id }} {
    --iwt-font-heading: 'Times ExtraBold', 'Playfair Display', serif;
    --iwt-font-body: 'Cabin', 'Inter', 'Poppins', sans-serif;
    --iwt-bg: {{ bg_color }};
    --iwt-pt: {{ padding_top }}px;
    --iwt-pb: {{ padding_bottom }}px;
    --iwt-gap: {{ content_gap }}px;
    --iwt-img-col: {{ image_col_width }}%;
    --iwt-text-pad: {{ text_padding }}px;
    --iwt-custom-ratio: {{ image_custom_ratio }}%;

    --iwt-h-desktop: {{ heading_size_desktop }}px;
    --iwt-h-mobile: {{ heading_size_mobile }}px;
    --iwt-h-color: {{ heading_color }};
    --iwt-h-lh: {{ heading_line_height }}%;
    --iwt-t-desktop: {{ text_size_desktop }}px;
    --iwt-t-mobile: {{ text_size_mobile }}px;
    --iwt-t-color: {{ text_color }};

    --iwt-btn-bg: {{ btn_bg }};
    --iwt-btn-text: {{ btn_text }};
    --iwt-btn-bg-hover: {{ btn_bg_hover }};
    --iwt-btn-text-hover: {{ btn_text_hover }};
    --iwt-btn-radius: {{ btn_radius }}px;
    --iwt-btn-desktop: {{ btn_size_desktop }}px;
    --iwt-btn-mobile: {{ btn_size_mobile }}px;
    --iwt-btn-mt: {{ btn_margin_top }}px;

    /* Números sin unidad para la interpolación fluida: cada sección usa los
       suyos (antes iban escritos en la regla, que no está acotada a la
       sección, y la última sección de la página mandaba sobre todas). */
    --iwt-h-d-n: {{ heading_size_desktop }};
    --iwt-h-m-n: {{ heading_size_mobile }};
    --iwt-t-d-n: {{ text_size_desktop }};
    --iwt-t-m-n: {{ text_size_mobile }};
    --iwt-b-d-n: {{ btn_size_desktop }};
    --iwt-b-m-n: {{ btn_size_mobile }};

    --iwt-radius: {{ image_radius }}px;
    --iwt-h-mb: {{ heading_margin_bottom }}px;
    --iwt-t-align: {{ text_align }};
    --iwt-t-weight: {{ text_weight }};
    --iwt-t-lh: {{ text_line_height | divided_by: 100.0 }};
    --iwt-p-gap: {{ paragraph_gap }}px;
    --iwt-frame: clamp(22px, 3.03vw, 60px);
    {%- if heading_accent != blank %}
    --iwt-h-accent: {{ heading_accent }};
    {%- endif %}
  }

  /* =============================================
     BASE
     ============================================= */
  .schar-iwt {
    background-color: var(--iwt-bg);
    padding: var(--iwt-pt) 0 var(--iwt-pb);
    margin-bottom: 0;
    position: relative;
    z-index: 1;
  }

  .schar-iwt__inner {
    display: grid;
    grid-template-columns: 1fr var(--iwt-img-col);
    gap: var(--iwt-gap);
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Vertical alignment */
  .schar-iwt__valign--top    { align-items: start; }
  .schar-iwt__valign--center { align-items: center; }
  .schar-iwt__valign--bottom { align-items: end; }

  /* Imagen a la izquierda: invertir orden */
  .schar-iwt--img-left .schar-iwt__inner {
    grid-template-columns: var(--iwt-img-col) 1fr;
  }

  .schar-iwt--img-left .schar-iwt__text-col { order: 2; }
  .schar-iwt--img-left .schar-iwt__img-col  { order: 1; }

  /* =============================================
     TEXTO
     ============================================= */
  .schar-iwt__text-col {
    padding: var(--iwt-text-pad) var(--header-desktop-padding, 63px);
  }

  .schar-iwt__heading,
  .schar-iwt__heading * {
    font-family: var(--iwt-font-heading) !important;
    font-style: normal;
    font-weight: 400 !important;
    color: var(--iwt-h-color);
    font-size: clamp(
      var(--iwt-h-mobile),
      calc(var(--iwt-h-mobile) + (var(--iwt-h-d-n) - var(--iwt-h-m-n)) * ((100vw - 375px) / (1440 - 375))),
      var(--iwt-h-desktop)
    );
    line-height: var(--iwt-h-lh);
    margin: 0 0 var(--iwt-h-mb) 0;
  }

  /* La parte en negrita toma el color de acento si está definido; si no,
     hereda el color del título (comportamiento anterior). */
  .schar-iwt__heading strong,
  .schar-iwt__heading b {
    font-weight: 400 !important;
    color: var(--iwt-h-accent, inherit);
  }

  .schar-iwt__text,
  .schar-iwt__text * {
    font-family: var(--iwt-font-body);
    font-size: clamp(
      var(--iwt-t-mobile),
      calc(var(--iwt-t-mobile) + (var(--iwt-t-d-n) - var(--iwt-t-m-n)) * ((100vw - 375px) / (1440 - 375))),
      var(--iwt-t-desktop)
    );
    line-height: var(--iwt-t-lh);
    font-weight: var(--iwt-t-weight);
    color: var(--iwt-t-color);
  }

  .schar-iwt__text { text-align: var(--iwt-t-align); }

  .schar-iwt__text p { margin: 0; }
  .schar-iwt__text p + p { margin-top: var(--iwt-p-gap); }

  .schar-iwt__text strong,
  .schar-iwt__text b {
    font-weight: 600;
  }

  .schar-iwt__text a {
    color: var(--iwt-h-color);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .schar-iwt__text a:hover {
    color: var(--iwt-btn-bg-hover);
  }

  /* =============================================
     BOTÓN
     ============================================= */
  .schar-iwt__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background-color: var(--iwt-btn-bg);
    color: var(--iwt-btn-text);
    border: none;
    border-radius: var(--iwt-btn-radius);
    font-family: var(--iwt-font-body);
    font-size: clamp(
      var(--iwt-btn-mobile),
      calc(var(--iwt-btn-mobile) + (var(--iwt-b-d-n) - var(--iwt-b-m-n)) * ((100vw - 375px) / (1440 - 375))),
      var(--iwt-btn-desktop)
    );
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
  }

  .schar-iwt__btn:hover {
    background-color: var(--iwt-btn-bg-hover);
    color: var(--iwt-btn-text-hover);
    transform: translateY(-1px);
  }

  .schar-iwt__btn-wrap {
    margin-top: var(--iwt-btn-mt);
  }

  /* =============================================
     IMAGEN
     ============================================= */
  .schar-iwt__img-col {
    position: relative;
    overflow: hidden;
  }

  .schar-iwt__img-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--iwt-radius);
  }

  .schar-iwt__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Ratios */
  .schar-iwt__img-wrap--portrait {
    aspect-ratio: 3 / 4;
  }

  .schar-iwt__img-wrap--square {
    aspect-ratio: 1 / 1;
  }

  .schar-iwt__img-wrap--landscape {
    aspect-ratio: 4 / 3;
  }

  .schar-iwt__img-wrap--auto {
    aspect-ratio: unset;
  }

  .schar-iwt__img-wrap--auto .schar-iwt__img {
    height: auto;
    object-fit: contain;
  }

  .schar-iwt__img-wrap--custom {
    aspect-ratio: unset;
    padding-bottom: var(--iwt-custom-ratio);
  }

  .schar-iwt__img-wrap--custom .schar-iwt__img {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* =============================================
     MOBILE
     ============================================= */
  @media (max-width: 680px) {
    .schar-iwt__inner {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* Imagen siempre arriba en mobile */
    .schar-iwt__img-col { order: 1; }
    .schar-iwt__text-col { order: 2; }

    .schar-iwt__text-col {
      padding: 28px var(--header-mobile-padding, 22px) 36px;
    }

    /* Sin border-radius en mobile (full-width) */
    .schar-iwt__img-wrap {
      border-radius: 0;
    }

    .schar-iwt__img-wrap--portrait,
    .schar-iwt__img-wrap--square,
    .schar-iwt__img-wrap--landscape {
      aspect-ratio: unset;
      max-height: 400px;
    }

    .schar-iwt__heading {
      margin-bottom: 16px;
    }
  }

  @media (min-width: 681px) and (max-width: 834px) {
    .schar-iwt__text-col {
      padding: var(--iwt-text-pad) var(--header-tablet-padding, 46px);
    }
  }

  @media (min-width: 835px) and (max-width: 1439px) {
    .schar-iwt__text-col {
      padding: var(--iwt-text-pad) var(--header-laptop-padding, 46px);
    }
  }

  @media (hover: hover) {
    .schar-iwt__btn:hover {
      background-color: var(--iwt-btn-bg-hover);
      color: var(--iwt-btn-text-hover);
    }
  }

  @media screen and (max-width: 760px) {
  .schar-iwt {
    padding: 0;
  }
}

  /* =============================================
     OPCIONES DE DISEÑO (todas opcionales desde los ajustes)
     ============================================= */

  /* Esquinas de la foto */
  #shopify-section-{{ section.id }} .schar-iwt--corner-none .schar-iwt__img-wrap { border-radius: 0; }
  #shopify-section-{{ section.id }} .schar-iwt--corner-outer_bottom .schar-iwt__img-wrap { border-radius: 0; }
  #shopify-section-{{ section.id }} .schar-iwt--corner-outer_bottom.schar-iwt--img-right .schar-iwt__img-wrap { border-bottom-right-radius: var(--iwt-radius); }
  #shopify-section-{{ section.id }} .schar-iwt--corner-outer_bottom.schar-iwt--img-left .schar-iwt__img-wrap { border-bottom-left-radius: var(--iwt-radius); }

  /* Márgenes laterales: foto y texto con el mismo margen al borde de la
     página, en vez de la foto pegada al borde. */
  @media (min-width: 681px) {
    #shopify-section-{{ section.id }} .schar-iwt--framed .schar-iwt__inner {
      padding-left: var(--iwt-frame);
      padding-right: var(--iwt-frame);
    }
    #shopify-section-{{ section.id }} .schar-iwt--framed .schar-iwt__text-col {
      padding-left: 0;
      padding-right: 0;
    }
  }

  @media (max-width: 680px) {
    /* En móvil la foto va a todo lo ancho y sin redondeo */
    #shopify-section-{{ section.id }} .schar-iwt__img-wrap { border-radius: 0; }

    #shopify-section-{{ section.id }} .schar-iwt--m-img-bottom .schar-iwt__text-col { order: 1; }
    #shopify-section-{{ section.id }} .schar-iwt--m-img-bottom .schar-iwt__img-col { order: 2; }

    #shopify-section-{{ section.id }} .schar-iwt--m-ratio-wide .schar-iwt__img-wrap {
      aspect-ratio: 360 / 202;
      padding-bottom: 0;
      max-height: none;
    }

    #shopify-section-{{ section.id }} .schar-iwt--m-h-center .schar-iwt__heading,
    #shopify-section-{{ section.id }} .schar-iwt--m-h-center .schar-iwt__heading * { text-align: center; }
    #shopify-section-{{ section.id }} .schar-iwt--m-h-left .schar-iwt__heading,
    #shopify-section-{{ section.id }} .schar-iwt--m-h-left .schar-iwt__heading * { text-align: left; }

    #shopify-section-{{ section.id }} .schar-iwt--framed .schar-iwt__text-col {
      padding: 22px clamp(16px, 4.7vw, 22px);
    }

    /* Separación entre párrafos proporcional al texto (máx. 1.2em) */
    #shopify-section-{{ section.id }} .schar-iwt__text p + p { margin-top: min(var(--iwt-p-gap), 1.2em); }
  }
{% endstyle %}
